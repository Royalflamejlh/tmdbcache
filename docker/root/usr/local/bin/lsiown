#!/usr/bin/env bash
# chown that quietly does nothing when the container is not running as root.
#
# `docker run --user 1000:1000` skips the init-adduser step entirely, and a
# non-root process cannot chown. Without this wrapper every init script would
# have to guard its own chown calls, or would spew errors on a perfectly valid
# rootless run.

if [[ $(id -u) -ne 0 ]]; then
    exit 0
fi

exec chown "$@"
