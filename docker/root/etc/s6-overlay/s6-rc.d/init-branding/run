#!/command/with-contenv bash
# Startup banner, in the shape LinuxServer.io images use.
#
# This project is not affiliated with linuxserver.io — it only follows their
# container conventions, which are genuinely pleasant to operate.

cat <<BANNER
────────────────────────────────────────────────────
    _            _ _                  _
   | |_ _ __ ___   __| | |__   ___ __ _  ___| |__   ___
   | __| '_ \` _ \\ / _\` | '_ \\ / __/ _\` |/ __| '_ \\ / _ \\
   | |_| | | | | | (_| | |_) | (_| (_| | (__| | | |  __/
    \\__|_| |_| |_|\\__,_|_.__/ \\___\\__,_|\\___|_| |_|\\___|

   A self-hosted, TMDB-backed video library
────────────────────────────────────────────────────
 Version:      ${TMDBCACHE_VERSION:-unknown}
 Build date:   ${TMDBCACHE_BUILD_DATE:-unknown}
 Source:       https://github.com/Royalflamejlh/tmdbcache
────────────────────────────────────────────────────
 This product uses the TMDB API but is not endorsed
 or certified by TMDB.
────────────────────────────────────────────────────
BANNER
